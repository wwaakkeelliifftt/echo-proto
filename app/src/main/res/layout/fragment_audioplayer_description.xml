<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <com.example.echo_proto.ui.view.NestedScrollableHost
        android:id="@+id/scrollHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/dtnToPlayer"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/descriptionScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvPlayerDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/colorOnSurface"
                android:textSize="16sp"
                tools:text="Episode description will appear here..." />

        </androidx.core.widget.NestedScrollView>

    </com.example.echo_proto.ui.view.NestedScrollableHost>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dtnToPlayer"
        style="@style/FeedFilterDialogButtonFilled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_small"
        android:text="back"
        android:textColor="@color/colorPrimary"
        android:backgroundTint="?android:colorBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
