<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:clipToOutline="true"
    android:outlineProvider="background"
    android:paddingBottom="24dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <View
        android:id="@+id/dragHandle"
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:background="@color/colorDisabled"
        android:alpha="0.3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/manage_keywords"
            android:textSize="24sp"
            android:fontFamily="@font/manrope_bold"
            android:textColor="@color/colorTextPrimary" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_speed_button"
            android:src="@drawable/ic_close"
            app:tint="@color/colorTextPrimary" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:boxBackgroundColor="@color/colorSurfaceContainerLow"
        app:boxCornerRadius="16dp"
        app:boxStrokeWidth="2dp"
        app:boxStrokeColor="@color/colorPrimary"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/colorPrimary"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/add_keyword_hint"
            android:inputType="text"
            android:maxLines="1"
            android:padding="20dp"
            android:textSize="18sp"
            android:textColor="@color/colorTextPrimary"
            android:fontFamily="@font/manrope_medium" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/active_filters"
        android:textSize="10sp"
        android:fontFamily="@font/manrope_bold"
        android:textAllCaps="true"
        android:textColor="@color/colorTextSecondary"
        android:letterSpacing="0.2" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp">

        <!-- Preview Chips with close buttons for Add state -->
        <com.google.android.material.chip.Chip
            style="@style/SpeedControlChipV2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sound Design"
            app:closeIconEnabled="true"
            app:closeIconVisible="true"
            app:closeIconTint="@color/colorPrimary" />

        <com.google.android.material.chip.Chip
            style="@style/SpeedControlChipV2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acoustics"
            app:closeIconEnabled="true"
            app:closeIconVisible="true"
            app:closeIconTint="@color/colorPrimary" />

    </com.google.android.material.chip.ChipGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearAll"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/clear_all"
            android:textColor="@color/colorTextPrimary"
            app:strokeColor="@color/colorSurfaceVariant"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveChanges"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/save_changes"
            android:textColor="@color/colorChipActiveText"
            android:backgroundTint="@color/colorPrimary"
            app:cornerRadius="16dp" />

    </LinearLayout>
</LinearLayout>
