<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:clipToOutline="true"
    android:outlineProvider="background"
    android:paddingBottom="@dimen/dp_medium"
    android:paddingStart="@dimen/dp_large"
    android:paddingEnd="@dimen/dp_large">

    <!-- Handle -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="48dp"
        android:layout_height="@dimen/dp_small"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp_medium"
        android:layout_marginBottom="24dp"
        android:background="@color/colorDisabled"
        android:alpha="0.3" />

    <!-- Header -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/feed_filter_title"
        android:textSize="24sp"
        android:fontFamily="@font/manrope_bold"
        android:textColor="@color/colorTextPrimary" />

    <!-- Input Field Group (Disabled/Placeholder style) -->
    <LinearLayout
        android:id="@+id/inputGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp"
        android:gravity="center_vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutNewFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            app:boxBackgroundColor="@color/colorSurfaceContainerLow"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputNewFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/feed_filter_hint"
                android:inputType="text"
                android:maxLines="1"
                android:padding="16dp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextSecondary"
                android:fontFamily="@font/manrope"
                android:enabled="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddFilter"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="@string/feed_filter_add"
            android:textColor="@color/colorDisabled"
            android:backgroundTint="@color/colorSurfaceContainerHighest"
            app:cornerRadius="12dp"
            android:enabled="false" />

    </LinearLayout>

    <!-- Chips Section Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Активные фильтры"
        android:textSize="11sp"
        android:fontFamily="@font/manrope_bold"
        android:textAllCaps="true"
        android:textColor="@color/colorTextSecondary"
        android:letterSpacing="0.2" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp">

        <!-- Preview Chips -->
        <com.google.android.material.chip.Chip
            style="@style/SpeedControlChipV2.Active"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sound Design" />

        <com.google.android.material.chip.Chip
            style="@style/SpeedControlChipV2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acoustics" />

        <com.google.android.material.chip.Chip
            style="@style/SpeedControlChipV2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Studio" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Info Hint Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hintCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/colorSurfaceVariant"
        app:cardBackgroundColor="@color/colorSurfaceContainerLowest">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_info_outline"
                app:tint="@color/colorAccentBlue" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Подсказка по UI"
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary"
                android:fontFamily="@font/manrope"
                android:alpha="0.8" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Footer Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/feed_filter_edit"
                android:textColor="@color/colorTextPrimary"
                android:fontFamily="@font/manrope_bold"
                app:strokeColor="@color/colorSurfaceVariant"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveChanges"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.5"
                android:layout_marginStart="12dp"
                android:text="Сохранить"
                android:textColor="@color/colorChipActiveText"
                android:backgroundTint="@color/colorPrimary"
                android:fontFamily="@font/manrope_bold"
                app:cornerRadius="16dp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiscard"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Отмена"
            android:textColor="@color/colorTextSecondary"
            android:fontFamily="@font/manrope_medium"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1" />
    </LinearLayout>
</LinearLayout>
