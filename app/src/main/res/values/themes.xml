<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Echoproto" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorChipActiveText</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorAccentBlue</item>
        <item name="colorSecondaryVariant">@color/white</item>
        <item name="colorOnSecondary">@color/colorTextSecondary</item>
        <item name="colorTertiary">@color/colorSurface</item>
        
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/black</item>
        
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>

        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <!--  styles for DialogFragment  -->
    <style name="AlertDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
    </style>
    <style name="NegativeButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/colorPrimary</item>
    </style>
    <style name="PositiveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <!-- Legacy Style to fix build error in bottom_sheet_speed_control.xml -->
    <style name="SpeedControlChip" parent="SpeedControlChipV2" />

    <!-- Speed Control Chip V2 (Inactive) -->
    <style name="SpeedControlChipV2" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/colorInactiveChipBackground</item>
        <item name="android:textColor">@color/colorInactiveChipText</item>
        <item name="android:textAppearance">@style/TextAppearance.SpeedChip.Inactive</item>
        <item name="rippleColor">@color/colorPrimary</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="cornerSize">24dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minWidth">60dp</item>
    </style>

    <style name="TextAppearance.SpeedChip.Inactive" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/colorInactiveChipText</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Speed Control Chip V2 (Active) -->
    <style name="SpeedControlChipV2.Active" parent="SpeedControlChipV2">
        <item name="chipBackgroundColor">@color/colorPrimaryVariant</item>
        <item name="android:textColor">@color/colorChipActiveText</item>
        <item name="android:textAppearance">@style/TextAppearance.SpeedChip.Active</item>
        <item name="chipIconTint">@color/colorChipActiveIcon</item>
        <item name="elevation">4dp</item>
    </style>

    <style name="TextAppearance.SpeedChip.Active" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/colorChipActiveText</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Filter Chips -->
    <style name="FilterChips" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:animateLayoutChanges">true</item>
    </style>

    <!-- Episode Detail V2 Text Appearances -->
    <style name="TextAppearance.EpisodeDetail.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.EpisodeDetail.Metadata" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.EpisodeDetail.Loading" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.EpisodeDetail.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.EpisodeDetail.SectionLabel" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.2</item>
    </style>

    <style name="TextAppearance.EpisodeDetail.Description" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.EpisodeDetail.Chapter.Time" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.EpisodeDetail.Chapter.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.EpisodeDetail.Chapter.Description" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>